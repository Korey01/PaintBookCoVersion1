# Database
DATABASE_URL="postgresql://user:password@localhost:5432/paintbook"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Payment & Escrow
STRIPE_SECRET_KEY="sk_test_your_stripe_key"
STRIPE_PUBLIC_KEY="pk_test_your_stripe_key"

TRANSPACT_API_KEY="your_transpact_api_key"
TRANSPACT_API_URL="https://api.transpact.com"

# Environment
NODE_ENV="development"
PORT="3000"

# Optional
PING_MESSAGE="pong"
LOG_LEVEL="debug"

# ── Paint Vestimator ──────────────────────────────────────────────────────────
# REPLICATE_API_KEY is a Supabase *secret*, not a frontend env var.
# Set it via: supabase secrets set REPLICATE_API_KEY=r8_...
# Do NOT prefix it with VITE_ — it must never reach the browser.
#
# Public Supabase vars (safe to expose — anon key only):
# VITE_SUPABASE_URL="https://xxxx.supabase.co"
# VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
